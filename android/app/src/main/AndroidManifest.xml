<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- la app se conecta a la API de Node (la misma del panel del administrador) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- usesCleartextTraffic: la API corre en la red local con http (sin https) -->
    <application
        android:allowBackup="true"
        android:icon="@drawable/simbolo"
        android:label="Caracoli"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- singleTask: si la app ya esta abierta, el enlace del QR llega a la misma pantalla (onNewIntent) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- CODIGO QR: el aviso abre caracoli://inmueble/CAR-102 y la app muestra ese inmueble -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="caracoli" android:host="inmueble" />
            </intent-filter>
        </activity>
    </application>
</manifest>
